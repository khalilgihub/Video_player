{
  "name": "postprocessing",
  "version": "6.38.3",
  "description": "A post processing library for three.js.",
  "homepage": "https://github.com/pmndrs/postprocessing",
  "license": "Zlib",
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/types/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/types/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/types/index.d.cts",
        "default": "./build/index.cjs"
      }
    }
  },
  "author": {
    "name": "Raoul van Rüschen",
    "email": "vanruesc@outlook.de"
  },
  "repository": {
    "url": "git+https://github.com/pmndrs/postprocessing.git"
  },
  "files": [
    "./build"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "hugo-bin"
    ]
  },
  "peerDependencies": {
    "three": ">= 0.157.0 < 0.184.0"
  },
  "devDependencies": {
    "@tweakpane/core": "2.x.x",
    "@types/node": "25.x.x",
    "@types/three": "0.x.x",
    "autoprefixer": "10.x.x",
    "ava": "6.x.x",
    "cpy-cli": "7.x.x",
    "cssnano": "7.x.x",
    "dat.gui": "0.x.x",
    "del-cli": "7.x.x",
    "esbuild": "0.27.x",
    "esbuild-plugin-glsl": "1.x.x",
    "esdoc": "1.x.x",
    "esdoc-importpath-plugin": "1.x.x",
    "esdoc-standard-plugin": "1.x.x",
    "eslint": "10.x.x",
    "eslint-config-aether": "2.x.x",
    "gzipper": "8.x.x",
    "hugo-bin": "0.x.x",
    "npm-run-all": "4.x.x",
    "postcss": "8.x.x",
    "postcss-cli": "11.x.x",
    "postcss-preset-env": "11.x.x",
    "sass": "1.x.x",
    "spatial-controls": "6.x.x",
    "stylelint": "17.x.x",
    "stylelint-config-standard-scss": "17.x.x",
